# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA MULTI-AGENTE "ALPACA SENTINEL PRO"
# Configura estas variables en tu panel de Dokploy o en un archivo .env local
# ==============================================================================

# 1. Configuración de Telegram (BotFather)
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_aqui
# Tu ID numérico de Telegram (para que solo tú puedas dar órdenes y recibir alertas)
TELEGRAM_ALLOWED_USER_ID=tu_id_numerico_aqui

# 2. Credenciales de Alpaca Markets
ALPACA_API_KEY=tu_alpaca_api_key
ALPACA_SECRET_KEY=tu_alpaca_secret_key
# Usar "https://paper-api.alpaca.markets" para Paper Trading o "https://api.alpaca.markets" para Live
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# 3. Configuración de OpenCode CLI y Modelos LLM
# big-pickle es gratuito y con 200k tokens de contexto
OPENCODE_MODEL=opencode/big-pickle

# 4. Configuración de Sistema y Horarios
NODE_ENV=production
# Sincronizado con el horario de Wall Street (New York)
TZ=America/New_York
PORT=3000
